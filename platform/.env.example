FLASK_APP=wsgi:app
FLASK_DEBUG=1
SECRET_KEY=change-me
DATABASE_URL=postgresql+psycopg://passkey:passkey@localhost:5432/passkey
DB_BACKEND=postgres
SSH_CA_KEY_PATH=./dev_ca/ssh_user_ca
SSH_CERT_TTL_SECONDS=300
LOCAL_AUTH_ENABLED=1
DEV_AUTH_ENABLED=0
ALLOWED_LOGIN_DOMAINS=example.com
FIRST_USER_ADMIN=1
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
SAML_METADATA_URL=
SCIM_ENABLED=0
