{% extends "admin/base.html" %}
{% block title %}Devices{% endblock %}
{% block admin_content %}
<div class="page-head">
  <div>
    <h1 class="page-title">Device Trust</h1>
    <div class="page-sub">Manage keyward-enrolled devices and their trust status</div>
  </div>
</div>

<div class="s-card">
  <div class="s-card-head">
    <div>
      <div class="s-card-title">All Devices</div>
      <div class="s-card-sub">{{ devices|length }} device{{ 's' if devices|length != 1 }}</div>
    </div>
    <input class="form-filter" type="text" placeholder="Filter devices…" data-filter-input data-filter-target="#devices-tbody tr">
  </div>
  <div class="dt-wrap">
    <table class="dt">
      <thead>
        <tr>
          <th>Device</th>
          <th>Platform</th>
          <th>Fingerprint</th>
          <th>User</th>
          <th>Status</th>
          <th>Trust</th>
          <th>Last Seen</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody id="devices-tbody">
        {% for device in devices %}
        <tr>
          <td style="font-weight:500;color:#e8eaed;">{{ device.name }}</td>
          <td><span class="tag">{{ device.platform }}</span></td>
          <td style="font-size:11px;font-family:'JetBrains Mono',monospace;color:var(--c-s4);" title="{{ device.fingerprint }}">{{ device.fingerprint[:20] ~ '…' if device.fingerprint|length > 20 else device.fingerprint }}</td>
          <td style="font-size:12px;color:var(--c-s4);">{{ device.user_id|string|truncate(8,True,'…') }}</td>
          <td>
            {% if device.status == 'trusted' %}<span class="sbadge sbadge-green">Trusted</span>
            {% elif device.status == 'pending' %}<span class="sbadge sbadge-amber">Pending</span>
            {% elif device.status == 'revoked' %}<span class="sbadge sbadge-red">Revoked</span>
            {% elif device.status == 'suspended' %}<span class="sbadge sbadge-muted">Suspended</span>
            {% else %}<span class="sbadge">{{ device.status }}</span>{% endif %}
          </td>
          <td>
            <span class="tag">{{ device.trust_level }}</span>
            {% if device.hardware_backed %}<span class="tag" style="background:rgba(34,197,94,.1);color:var(--c-green);margin-left:3px;">HW</span>{% endif %}
          </td>
          <td style="font-size:12px;color:var(--c-s4);" title="{{ device.posture }}">
            {{ device.last_seen_at.strftime('%Y-%m-%d') if device.last_seen_at else '—' }}
          </td>
          <td>
            <div style="display:flex;gap:4px;flex-wrap:wrap;">
              {% if device.status != 'trusted' %}
              <form method="POST" action="{{ url_for('admin.devices_status', device_id=device.id) }}">
                <input type="hidden" name="status" value="trusted">
                <button class="btn-ghost" type="submit" style="font-size:11px;padding:3px 9px;color:var(--c-green);border-color:rgba(34,197,94,.3);">Trust</button>
              </form>
              {% endif %}
              {% if device.status not in ('suspended','revoked') %}
              <form method="POST" action="{{ url_for('admin.devices_status', device_id=device.id) }}">
                <input type="hidden" name="status" value="suspended">
                <button class="btn-ghost" type="submit" style="font-size:11px;padding:3px 9px;color:var(--c-amber);border-color:rgba(245,158,11,.3);">Suspend</button>
              </form>
              {% endif %}
              {% if device.status != 'revoked' %}
              <form method="POST" action="{{ url_for('admin.devices_revoke', device_id=device.id) }}">
                <button class="btn-danger" type="submit" style="font-size:11px;padding:3px 9px;" onclick="return confirm('Revoke device {{ device.name }}?')">Revoke</button>
              </form>
              {% endif %}
            </div>
          </td>
        </tr>
        {% else %}
        <tr><td colspan="8" class="dt-empty">No devices enrolled yet.</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
{% endblock %}
